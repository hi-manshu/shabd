{
  "name": "@himanshoe/shabd",
  "version": "0.1.0",
  "description": "YAML-driven, local-first documentation framework with semantic search, MCP, live studio and sandboxes",
  "keywords": [
    "documentation",
    "docs",
    "markdown",
    "mdx",
    "yaml",
    "static-site-generator",
    "mcp",
    "llms-txt",
    "semantic-search"
  ],
  "homepage": "https://github.com/hi-manshu/shabd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-manshu/shabd.git",
    "directory": "packages/shabd"
  },
  "bugs": {
    "url": "https://github.com/hi-manshu/shabd/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "shabd": "bin/shabd.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/node/vite/plugin.d.ts",
      "import": "./dist/node/vite/plugin.js"
    },
    "./mcp": {
      "types": "./dist/node/mcp/index.d.ts",
      "import": "./dist/node/mcp/index.js"
    },
    "./schema": {
      "types": "./dist/shared/schema.d.ts",
      "import": "./dist/shared/schema.js"
    },
    "./client": "./src/client/index.ts",
    "./package.json": "./package.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "src/client",
    "src/shared"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.node.json && node scripts/gen-schemas.mjs",
    "prepack": "npm run build",
    "dev": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vitejs/plugin-react": "^6.3.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "picocolors": "^1.1.1",
    "rehype-mdx-import-media": "^1.4.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "sucrase": "^3.35.1",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "vite": "^8.3.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.0.0",
    "@resvg/resvg-js": "^2.6.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    },
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    },
    "rehype-katex": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}

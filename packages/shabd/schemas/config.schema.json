{
  "title": "Shabd site configuration (shabd.config.yaml)",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "base": {
          "default": "/",
          "type": "string"
        },
        "urls": {
          "default": "clean",
          "type": "string",
          "enum": [
            "clean",
            "slash",
            "html"
          ]
        },
        "lang": {
          "default": "en",
          "type": "string",
          "minLength": 2
        },
        "logo": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                },
                "light": {
                  "type": "string",
                  "minLength": 1
                },
                "dark": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string"
                },
                "height": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^;{}<>]+$"
                },
                "href": {
                  "type": "string",
                  "minLength": 1
                },
                "replacesTitle": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "favicon": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "branch": {
                  "default": "main",
                  "type": "string",
                  "minLength": 1
                },
                "dir": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          ]
        },
        "social": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "icon": {
                    "type": "string",
                    "minLength": 1
                  },
                  "href": {
                    "type": "string",
                    "format": "uri"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "icon",
                  "href"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "format": "uri"
              }
            }
          ]
        },
        "nav": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "link": {
                "type": "string",
                "minLength": 1
              },
              "badge": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "variant": {
                        "type": "string",
                        "enum": [
                          "default",
                          "note",
                          "tip",
                          "success",
                          "caution",
                          "danger"
                        ]
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "label",
              "link"
            ],
            "additionalProperties": false
          }
        },
        "footer": {
          "type": "string"
        },
        "head": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "meta",
                  "link",
                  "script",
                  "style",
                  "noscript"
                ]
              },
              "attrs": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_:][A-Za-z0-9_:.-]*$"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "tag"
            ],
            "additionalProperties": false
          }
        },
        "noindex": {
          "default": false,
          "type": "boolean"
        },
        "robots": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "disallow": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^\\/\\S*$"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
